/* ── Storage ── */
const LS = {
  get: (k, f = null) => {
    try {
      const v = localStorage.getItem(k);
      return v ? JSON.parse(v) : f;
    } catch {
      return f;
    }
  },
  set: (k, v) => localStorage.setItem(k, JSON.stringify(v)),
  rm: (k) => localStorage.removeItem(k),
};

const VER = "v3";

